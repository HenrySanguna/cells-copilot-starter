{
  "private": true,
  "name": "cells-copilot-starter",
  "description": "Open Cells starter wired for security remediation with GitHub Copilot (agents, skills, lightweight SDD)",
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "pnpm build && vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "pnpm audit --prod",
    "audit:all": "pnpm audit",
    "check": "pnpm store status && pnpm lint && pnpm test && pnpm build && pnpm audit --prod"
  },
  "dependencies": {
    "@open-cells/core": "^1.2.1",
    "@open-cells/element-controller": "^1.0.6",
    "@open-cells/page-controller": "^1.0.6",
    "dompurify": "^3.3.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.0.0",
    "eslint-plugin-lit": "^2.0.0",
    "globals": "^17.0.0",
    "jsdom": "^30.1.3",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.2.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  }
}
